# Copie para .env e preencha. O .env nunca vai para o git.

# Onde os dados ficam:
#   vazio  -> pasta local dados/ (arquivos, bom para começar)
#   preenchido -> Postgres com pgvector (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=

# Modelos de embedding (todos locais e gratuitos):
#   clip     -> CLIP para fotos e para textos
#   clip+e5      -> CLIP para fotos, multilingual-e5-small para textos (rápido: 30 ms por produto)
#   clip+gemma2  -> CLIP para fotos, EmbeddingGemma 2 para textos (escolhido: ver docs/resultados-busca.md)
#   gemma2       -> EmbeddingGemma 2 para textos e fotos (sem GPU, ~20 s por foto)
#   fake     -> só para testes, sem significado
EMBEDDER=clip+gemma2
# Que texto do produto vira vetor: "completo" (título + loja + categoria + destaques) ou "titulo" (título + loja)
TEXTO_ITEM=titulo

# Juiz de relevância com IA (mini-lcm julgar). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
JUIZ_MODELO=gemini-3.5-flash-lite
# Preços em US$ por 1 milhão de tokens, copiados de https://ai.google.dev/gemini-api/docs/pricing
# (deixe 0 se não quiser calcular o custo; os tokens são registrados de qualquer jeito)
JUIZ_PRECO_ENTRADA_1M=0
JUIZ_PRECO_SAIDA_1M=0
